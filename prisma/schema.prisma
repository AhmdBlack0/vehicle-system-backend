// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

/// User roles in the system
enum Role {
  ADMIN
  WORKER
}

/// Vehicle operational status
enum VehicleStatus {
  ACTIVE
  INACTIVE
}

/// Tank transaction type
enum TankTransactionType {
  ADD
  WITHDRAW
}

// ─── Models ───────────────────────────────────────────────────────────────────

/// System users — both admins and workers
model User {
  id        Int      @id @default(autoincrement())
  fullName  String
  username  String   @unique
  password  String
  role      Role     @default(WORKER)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Fuel logs created by this worker
  fuelLogs FuelLog[]
  /// Tank transactions performed by this user
  tankTransactions TankTransaction[]

  @@map("users")
}

/// Company vehicles tracked by the system
model Vehicle {
  id            Int           @id @default(autoincrement())
  barcode       String        @unique
  vehicleNumber String
  plateNumber   String
  vehicleType   String
  department    String
  status        VehicleStatus @default(ACTIVE)
  imageUrl      String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  /// Fuel logs associated with this vehicle
  fuelLogs FuelLog[]
  /// Tank transactions associated with this vehicle (withdrawals)
  tankTransactions TankTransaction[]

  @@map("vehicles")
}

/// Fuel operations log — one record per fueling event
model FuelLog {
  id                  Int      @id @default(autoincrement())
  vehicleId           Int
  workerId            Int
  fuelPrice           Decimal  @db.Decimal(10, 2)
  fuelQuantity        Decimal  @db.Decimal(10, 2)
  totalPrice          Decimal  @db.Decimal(10, 2)
  notes               String?
  odometerBefore      String?
  odometerAfter       String?
  pumpBefore          String?
  pumpAfter           String?
  latitude            Float?
  longitude           Float?
  odometerBeforeImage String?
  odometerAfterImage  String?
  pumpBeforeImage     String?
  pumpAfterImage      String?
  createdAt           DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  worker  User    @relation(fields: [workerId], references: [id], onDelete: Restrict)

  @@map("fuel_logs")
}

/// Main fuel tank for tracking fuel inventory
model Tank {
  id              Int                @id @default(autoincrement())
  currentBalance  Decimal            @db.Decimal(10, 2) @default(0)
  totalAdded      Decimal            @db.Decimal(10, 2) @default(0)
  totalWithdrawn  Decimal            @db.Decimal(10, 2) @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  transactions    TankTransaction[]

  @@map("tank")
}

/// Tank transaction log — tracks all fuel additions and withdrawals
model TankTransaction {
  id              Int                @id @default(autoincrement())
  tankId          Int
  type            TankTransactionType
  quantity        Decimal            @db.Decimal(10, 2)
  balanceBefore   Decimal            @db.Decimal(10, 2)
  balanceAfter    Decimal            @db.Decimal(10, 2)
  userId          Int
  vehicleId       Int?
  notes           String?
  tankBeforeImage String?
  tankAfterImage  String?
  createdAt       DateTime           @default(now())

  tank    Tank  @relation(fields: [tankId], references: [id], onDelete: Cascade)
  user    User  @relation(fields: [userId], references: [id], onDelete: Restrict)
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@map("tank_transaction")
}

/// System settings — stores global configuration
model Settings {
  id         Int     @id @default(1)
  fuelPrice  Decimal @db.Decimal(10, 2) @default(0)
  updatedAt  DateTime @updatedAt

  @@map("settings")
}
